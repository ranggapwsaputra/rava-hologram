# R.A.V.A Frontend — Vite Environment Variables Template
# Salin file ini menjadi .env, lalu isi API key Anda.
# cp .env.example .env
#
# File .env TIDAK akan di-commit ke git (sudah ada di .gitignore).

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Pilih: "gemini" (Google) atau "openrouter" (akses multi-model)
VITE_RAVA_AI_PROVIDER=gemini

# ─── Google Gemini API Key ─────────────────────────────────────────────────────
# Dapatkan gratis di: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ─── OpenRouter API Key ────────────────────────────────────────────────────────
# Dapatkan di: https://openrouter.ai/keys
# Mendukung banyak model: google/gemini-2.5-flash, openai/gpt-4o-mini, dll
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── OpenRouter Model (opsional, default: google/gemini-2.5-flash) ────────────
# Referensi model: https://openrouter.ai/models
# VITE_OPENROUTER_MODEL=google/gemini-2.5-flash
